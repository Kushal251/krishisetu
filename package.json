{
  "name": "krishisetu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "ml:start": "powershell -ExecutionPolicy Bypass -File ml-service/start.ps1",
    "ml:data:generate": "node scripts/mvp-ml-data.mjs generate",
    "ml:data:seed-history": "node scripts/mvp-ml-data.mjs seed-history",
    "ml:data:tick": "node scripts/mvp-ml-data.mjs tick --hours 1",
    "ml:train:once": "powershell -ExecutionPolicy Bypass -File ml-service/auto-train.ps1 --once",
    "ml:train:hourly": "powershell -ExecutionPolicy Bypass -File ml-service/auto-train.ps1 --watch",
    "lint": "eslint",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "prisma": "^6.16.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4"
  }
}
